---
// Eixo de peso apenas (100-900). Os @font-face trazem unicode-range,
// por isso o browser so descarrega o subset latino.
import '@fontsource-variable/noto-sans/wght.css'
import '../styles/app.css'
import { codigos, NOMES, caminhoDe, LINGUA_OMISSAO } from '../content/langs.js'

const { site, lang = LINGUA_OMISSAO } = Astro.props
const { meta } = site
const base = import.meta.env.BASE_URL
const asset = (path) => `${base}${path}`.replace(/\/{2,}/g, '/')

---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{meta.name} — {meta.role}</title>
    <meta name="description" content={meta.description} />
    <meta name="theme-color" content="#0d0d10" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${meta.name} — ${meta.role}`} />
    <meta property="og:description" content={meta.description} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />

    <script is:inline>
      // Antes do primeiro paint, senao ve-se o flash do tema errado.
      try {
        var saved = localStorage.getItem('rg-theme')
        if (saved) document.documentElement.dataset.theme = saved
      } catch (e) {}
    </script>

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: meta.name,
      jobTitle: meta.role,
      email: `mailto:${meta.email}`,
      url: new URL(Astro.url.pathname, Astro.site).href,
      sameAs: meta.social.filter((s) => s.href).map((s) => s.href),
    })} />
  </head>

  <body>
    <a class="skip-link" href="#conteudo">Saltar para o conteúdo</a>

    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Mudar de tema">
      <svg class="icon icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4.2" />
        <path d="M12 2.6v2.2M12 19.2v2.2M21.4 12h-2.2M4.8 12H2.6M18.6 5.4 17 7M7 17l-1.6 1.6M18.6 18.6 17 17M7 7 5.4 5.4" />
      </svg>
      <svg class="icon icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 14.2A8.4 8.4 0 0 1 9.8 4a8.4 8.4 0 1 0 10.2 10.2Z" />
      </svg>
    </button>

    {codigos.length > 1 && (
      <nav class="lang-switch" aria-label="Língua">
        {codigos.map((codigo) => (
          <a
            href={caminhoDe(codigo, base)}
            hreflang={codigo}
            aria-current={codigo === lang ? 'true' : undefined}
          >{codigo.toUpperCase()}<span class="visually-hidden"> — {NOMES[codigo] ?? codigo}</span></a>
        ))}
      </nav>
    )}

    <main id="conteudo"><slot /></main>

    <footer class="site-footer">
      <div class="wrap">
        <p>© <span id="year">2026</span> {meta.name}. Construído com Astro, alojado no GitHub Pages.</p>
      </div>
    </footer>

    <script is:inline>
      document.getElementById('year').textContent = new Date().getFullYear()
    </script>
    <script>
      import '../scripts/theme.js'
      import '../scripts/motion.js'
    </script>
  </body>
</html>
