---
import { Image } from 'astro:assets'
import photo from '../assets/rui.jpg'

const { block, site } = Astro.props
const { meta } = site
const base = import.meta.env.BASE_URL
const asset = (p) => `${base}${p}`.replace(/\/{2,}/g, '/')
---
<section id="top" class="hero" data-reveal-group>
  <div class="hero__copy">
    {meta.available && <p class="badge">{meta.availableLabel}</p>}
    <p class="eyebrow" data-reveal>{block.eyebrow}</p>
    <h1 data-split>{block.headline}</h1>
    <p class="muted" data-reveal>{block.body}</p>
    <div class="cta-row" data-reveal>
      <a class="btn btn-primary" href="#projetos">Ver projetos</a>
      <a class="btn btn-ghost" href={asset(meta.cv)} target="_blank" rel="noopener">CV em PDF</a>
    </div>
  </div>

  <div class="hero__media" data-reveal>
    <Image
      src={photo}
      alt={`Fotografia de ${meta.name}`}
      width={1400}
      height={1867}
      widths={[640, 1000, 1400]}
      sizes="(min-width: 900px) 50vw, (min-width: 640px) 520px, 100vw"
      format="webp"
      quality={78}
      loading="eager"
      fetchpriority="high"
    />
  </div>
</section>
