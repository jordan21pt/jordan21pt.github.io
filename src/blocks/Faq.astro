---
const { block } = Astro.props
---
<section id={block.id} class="section" data-reveal-group>
  <div class="wrap">
    <h2 data-split>{block.title}</h2>
    <div class="faq" data-reveal>
      {block.items.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
